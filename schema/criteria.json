      "blocking": true,
      "source": "schema/prd.md:85"
    },
    {
      "id": "PRD-NO-PLACEHOLDER",
      "layer": "prd",
      "title": "PRD 正文不得残留模板占位符",
      "kind": "no_placeholder",
      "params": {},
      "blocking": true,
      "source": "schema/prd.md:30"
    },

