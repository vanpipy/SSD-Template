      },
      "blocking": true,
      "source": "schema/prd.md:41"
    },
    {
      "id": "PRD-REVIEW-BLOCK",
      "layer": "prd",
      "title": "复审块 4 行齐全(评审人 / 评审日期 / 评审结论 / 评审方式)",
      "kind": "count_min",
      "params": {
        "regex": "^> \\*\\*(评审人|评审日期|评审结论|评审方式)\\*\\*:",
        "min_count": 4
      },
      "blocking": true,
      "source": "schema/prd.md:85"
    },
    {
      "id": "PRD-REVIEWER",
      "layer": "prd",
      "title": "评审人取值只能是 agent:<id> 或裸 handle;禁止 human: 前缀",
      "kind": "line_present",
      "params": {
        "regex": "^> \\*\\*评审人\\*\\*:\\s*(agent:[A-Za-z0-9._-]+|[A-Za-z0-9._-]+)?$"
