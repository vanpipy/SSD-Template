      "params": {
        "from_prefix": "AC",
        "to_prefix": "S",
        "via_field": "覆盖"
      },
      "blocking": true,
      "source": "schema/prd.md:41"
    },
    {
      "id": "PRD-GIVEN-WHEN-THEN",
      "layer": "prd",
      "title": "场景必须写 Given / When / Then 三段",
      "kind": "count_min",
      "params": {
        "regex": "^\\*\\*(Given|When|Then)\\*\\*",
