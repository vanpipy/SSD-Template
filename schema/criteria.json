      "blocking": true,
      "source": "schema/prd.md:85"
    },
    {
      "id": "PRD-REVIEW-METHOD",
      "layer": "prd",
      "title": "评审方式取值只能是 自动判据 / 人工介入 / 外部事实(草稿可空)",
