      "kind": "id_refs_resolve",
      "params": {
        "from_prefix": "S",
        "to_prefix": "AC",
        "via_field": "覆盖"
      },
      "blocking": true,
      "source": "schema/prd.md:41"
    },
    {
      "id": "PRD-READY-02",
      "layer": "prd",
      "title": "每个 AC-n 至少被一个 S-n 的覆盖行覆盖",
